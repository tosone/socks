+/// A packet-oriented device that a [`Tun`] can relay traffic on.
+///
+/// Implement this when the host platform owns the packet source/sink and does
+/// not expose a TUN file descriptor, for example the packet flow of an Apple
+/// `NEPacketTunnelProvider`. The device exchanges raw IP packets (L3) through
+/// its [`AsyncRead`]/[`AsyncWrite`] implementation.
+pub trait TunStream: AsyncRead + AsyncWrite + Unpin + Send {
+    /// Local IPv4/IPv6 address assigned to this device.
+    fn address(&self) -> IpAddr;
+    /// Netmask of [`TunStream::address`].
+    fn netmask(&self) -> IpAddr;
+    /// Device name, used for logging only.
+    fn tun_name(&self) -> String {
+        "virtual".to_owned()
+    }
+}
+
+/// Concrete device backing a [`Tun`].
+enum Device {
+    /// A real TUN device created from [`TunConfiguration`].
+    Real(AsyncDevice),
+    /// A host-provided device, e.g. a NetworkExtension packet flow.
+    Virtual(Box<dyn TunStream>),
+}
+
+impl Device {
+    fn tun_name(&self) -> io::Result<String> {
+        match self {
+            Device::Real(device) => Ok(device.tun_name().unwrap_or_else(|_| "tun".to_owned())),
+            Device::Virtual(device) => Ok(device.tun_name()),
+        }
+    }
+
+    fn address(&self) -> io::Result<IpAddr> {
+        match self {
+            Device::Real(device) => device.address().map_err(|err| io::Error::other(err)),
+            Device::Virtual(device) => Ok(device.address()),
+        }
+    }
+
+    fn netmask(&self) -> io::Result<IpAddr> {
+        match self {
+            Device::Real(device) => device.netmask().map_err(|err| io::Error::other(err)),
+            Device::Virtual(device) => Ok(device.netmask()),
+        }
+    }
+
+    fn mtu(&self) -> u16 {
+        match self {
+            Device::Real(device) => device.mtu().unwrap_or(1500),
+            Device::Virtual(_) => 1500,
+        }
+    }
+}
+
+impl AsyncRead for Device {
+    fn poll_read(self: Pin<&mut Self>, cx: &mut Context<'_>, buf: &mut ReadBuf<'_>) -> Poll<io::Result<()>> {
+        match self.get_mut() {
+            Device::Real(device) => Pin::new(device).poll_read(cx, buf),
+            Device::Virtual(device) => Pin::new(device.as_mut()).poll_read(cx, buf),
+        }
+    }
+}
+
+impl AsyncWrite for Device {
+    fn poll_write(self: Pin<&mut Self>, cx: &mut Context<'_>, buf: &[u8]) -> Poll<io::Result<usize>> {
+        match self.get_mut() {
+            Device::Real(device) => Pin::new(device).poll_write(cx, buf),
+            Device::Virtual(device) => Pin::new(device.as_mut()).poll_write(cx, buf),
+        }
+    }
+
+    fn poll_flush(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        match self.get_mut() {
+            Device::Real(device) => Pin::new(device).poll_flush(cx),
+            Device::Virtual(device) => Pin::new(device.as_mut()).poll_flush(cx),
+        }
+    }
+
+    fn poll_shutdown(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        match self.get_mut() {
+            Device::Real(device) => Pin::new(device).poll_shutdown(cx),
+            Device::Virtual(device) => Pin::new(device.as_mut()).poll_shutdown(cx),
+        }
+    }
+}
