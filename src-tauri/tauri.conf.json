{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "socks",
  "version": "0.1.0",
  "identifier": "com.tosone.socks",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 540,
        "height": 760,
        "resizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns"],
    "resources": {
      "resources/plugins/v2ray-plugin/v2ray-plugin": "plugins/v2ray-plugin"
    }
  }
}
